{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConceptCAD",
  "mainBinaryName": "ConceptCAD",
  "version": "../../package.json",
  "identifier": "fr.conceptcad.logiciel",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "ConceptCAD", "width": 1400, "height": 900, "url": "index.html", "dragDropEnabled": false }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["conceptcad"], "name": "Projet ConceptCAD", "description": "Projet ConceptCAD", "role": "Editor" }
    ]
  }
}
